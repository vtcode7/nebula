rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isPlayer(game) {
      return game.player1.uid == request.auth.uid || 
             (game.player2 != null && game.player2.uid == request.auth.uid);
    }

    // Validation Helpers
    function isValidPlayer(p) {
      return p.uid is string && p.name is string && p.elixir is number && p.lastElixirUpdate is number;
    }

    function isValidGame(data) {
      return data.status in ['waiting', 'playing', 'finished'] &&
             data.createdAt is number &&
             data.updatedAt is timestamp &&
             isValidPlayer(data.player1) &&
             (data.player2 == null || isValidPlayer(data.player2)) &&
             data.deployments is list &&
             data.towers is list;
    }

    match /games/{gameId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (
        resource.data.player1.uid == request.auth.uid ||
        (resource.data.player2 != null && resource.data.player2.uid == request.auth.uid) ||
        resource.data.status == 'waiting'
      );

      allow create: if isSignedIn() && 
                    isValidId(gameId) &&
                    isValidGame(incoming()) &&
                    incoming().player1.uid == request.auth.uid &&
                    incoming().status == 'waiting' &&
                    incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
                    (
                      // Action: Join Game
                      (
                        existing().status == 'waiting' &&
                        existing().player2 == null &&
                        incoming().player2.uid == request.auth.uid &&
                        incoming().status == 'playing' &&
                        incoming().updatedAt == request.time &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['player2', 'status', 'updatedAt'])
                      ) ||
                      // Action: Deploy Card
                      (
                        existing().status == 'playing' &&
                        isPlayer(existing()) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['deployments'])
                      ) ||
                      // Action: Finish Game
                      (
                        existing().status == 'playing' &&
                        isPlayer(existing()) &&
                        incoming().status == 'finished' &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'winner'])
                      )
                    );

      allow delete: if false;
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
