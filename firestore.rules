rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Helpers
    function isValidGame(data) {
      return data.grid is list &&
             data.status in ['waiting', 'playing', 'finished'] &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             (data.player1 == null || (data.player1.uid is string && data.player1.score is number)) &&
             (data.player2 == null || (data.player2.uid is string && data.player2.score is number));
    }

    match /games/{gameId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (
        resource.data.player1.uid == request.auth.uid ||
        resource.data.player2.uid == request.auth.uid ||
        resource.data.status == 'waiting'
      );

      allow create: if isSignedIn() && 
                    isValidId(gameId) &&
                    isValidGame(incoming()) &&
                    incoming().player1.uid == request.auth.uid &&
                    incoming().status == 'waiting' &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
                    isValidGame(incoming()) &&
                    (
                      // Action: Join Game
                      (
                        existing().status == 'waiting' &&
                        existing().player2 == null &&
                        incoming().player2.uid == request.auth.uid &&
                        incoming().status == 'playing' &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['player2', 'status', 'updatedAt', 'turn'])
                      ) ||
                      // Action: Make Move
                      (
                        existing().status == 'playing' &&
                        existing().turn == request.auth.uid &&
                        (existing().player1.uid == request.auth.uid || existing().player2.uid == request.auth.uid) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['grid', 'player1', 'player2', 'turn', 'status', 'updatedAt', 'lastMove'])
                      )
                    ) &&
                    incoming().updatedAt == request.time;

      allow delete: if false; // Games should not be deleted by clients for now
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
